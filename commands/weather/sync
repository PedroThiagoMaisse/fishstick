#!/bin/bash

ENV_FILE="$HOME/.config/fishstick/.env"

if [ -f "$ENV_FILE" ]; then
    source "$ENV_FILE"
else
    if [ "$1" == "-wb" ]; then
        echo '{"text": "ERR", "tooltip": "Environment file not found"}'
    else
        echo "Error: Environment file not found."
    fi
    exit 1
fi

if [ -z "$LOC" ]; then
    if [ "$1" == "-wb" ]; then
        echo '{"text": "No Loc", "tooltip": "Run your geo-update script first"}'
    else
        echo "Error: LOC (coordinates) not found in $ENV_FILE."
    fi
    exit 1
fi

WEATHER_DATA=$(curl -s "wttr.in/${LOC}?format=%c+%t")

if [ $? -eq 0 ] && [ ! -z "$WEATHER_DATA" ]; then
    
    if [ "$1" == "-wb" ]; then
        echo "{\"text\": \"$WEATHER_DATA\", \"tooltip\": \"Zip: $ZIP | Coordinates: $LOC\"}"
    else
        dbus-send --session --type=signal \
                  /com//Weather \
                  com..Weather.Updated \
                  string:"CLIMATE" string:"$WEATHER_DATA"
        
        echo "Broadcasted: $WEATHER_DATA"
    fi
else
    if [ "$1" == "-wb" ]; then
        echo '{"text": "NaN", "tooltip": "Weather service unreachable"}'
    else
        echo "Error: Could not retrieve climate data."
    fi
    exit 1
fi