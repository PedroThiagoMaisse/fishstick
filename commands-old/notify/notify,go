package main

import (
	"fmt"
	"os"
	"os/exec"
)

func main() {
	// 1. Set the DBUS_SESSION_BUS_ADDRESS environment variable
	uid := os.Getuid()
	dbusAddr := fmt.Sprintf("unix:path=/run/user/%d/bus", uid)
	err := os.Setenv("DBUS_SESSION_BUS_ADDRESS", dbusAddr)
	if err != nil {
		fmt.Printf("Error setting env var: %v\n", err)
		return
	}

	// 2. Toggle dunst paused state
	dunstCmd := exec.Command("dunstctl", "set-paused", "toggle")
	if err := dunstCmd.Run(); err != nil {
		fmt.Printf("Error executing dunstctl: %v\n", err)
	}

	// 3. Send update to D-Bus as a key/value pair
	// Replace "com.example.Update", "/com/example/Update", and the key/value
	// with your specific interface, path, and data.
	busDestination := "org.freedesktop.DBus" // Update this to your target service
	objectPath := "/org/freedesktop/DBus"    // Update this to your target path
	interfaceName := "org.example.Update"   // Update this to your target interface
	
	key := "status"
	value := "updated"

	// Formatting the call: dbus-send --session --type=signal /path interface.Member string:key string:value
	dbusCmd := exec.Command("dbus-send", 
		"--session", 
		"--dest="+busDestination, 
		objectPath, 
		interfaceName, 
		"string:"+key, 
		"string:"+value,
	)

	if err := dbusCmd.Run(); err != nil {
		fmt.Printf("Error sending D-Bus update: %v\n", err)
	}
}